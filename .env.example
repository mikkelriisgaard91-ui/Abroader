# Teamtailor API — connect when going live
TEAMTAILOR_API_KEY=
TEAMTAILOR_RECRUITER_USER_ID=

# How often the site re-fetches jobs from Teamtailor (seconds, default 60 = 1 min)
TEAMTAILOR_REVALIDATE_SECONDS=60

# How often open pages poll /api/jobs for live updates (ms, default 60000 = 1 min)
NEXT_PUBLIC_JOBS_POLL_INTERVAL_MS=60000
